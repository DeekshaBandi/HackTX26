# Judge site: paste the SerpAPI key after the equals sign.
VITE_SERPAPI_KEY=
# Live transcript panel: where the Vite dev server finds the phone server (server.py).
PHONE_SERVER_URL=http://127.0.0.1:8000

# The phone server (server.py) and the operator
MODEL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Protects the dashboard and call records (open them with ?token=...). Vite also
# adds it to the live transcript's /dashboard connection. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
# Optional (defaults shown)
SPARK_MODEL=muse-spark-1.3
SPARK_REASONING_EFFORT=minimal
SPARK_MAX_TOKENS=1500
ELEVENLABS_MODEL=eleven_flash_v2_5
